{
  "name": "@jonjon29/slidev-theme-db-theme",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonJon29/DB-Slidev.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "deutsche-bahn"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "slidev build example.md",
    "dev": "slidev example.md --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.9.1"
  },
  "devDependencies": {
    "@slidev/cli": "^52.9.1"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "DB Screen Sans",
        "serif": "DB Screen Head",
        "mono": "Fira Code",
        "local": [
          "DB Screen Sans",
          "DB Screen Head"
        ]
      },
      "themeConfig": {
        "primary": "#EC0016",
        "sender": "",
        "logo": true,
        "logoColor": "red",
        "schwelle": true,
        "footer": "",
        "pageNumbers": true,
        "progress": false
      },
      "transition": "db-slide | db-slide-back"
    }
  }
}
